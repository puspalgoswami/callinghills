
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "ayrwmWLYxxPa7BReRFZYA3lKHQY2";
    }

    match /{collection}/{document=**} {
      allow read: if (
        collection in [
          'regions',
          'places',
          'packages',
          'hotels',
          'carRentals',
          'blog'
        ]
        && resource.data.published == true
      ) || (
        collection in [
          'regions',
          'places',
          'packages',
          'hotels',
          'carRentals',
          'blog'
        ]
        && isAdmin()
      );

      allow create, update, delete: if
        collection in [
          'regions',
          'places',
          'packages',
          'hotels',
          'carRentals',
          'blog'
        ] && isAdmin();
    }
  }
}

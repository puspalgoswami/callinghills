
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "ayrwmWLYxxPa7BReRFZYA3lKHQY2";
    }

    function isContentCollection(collection) {
      return collection in [
        "regions",
        "places",
        "packages",
        "packageOverrides",
        "hotels",
        "carRentals",
        "blog"
      ];
    }

    match /{collection}/{document=**} {
      allow read: if isContentCollection(collection)
        && (
          resource.data.published == true
          || isAdmin()
        );

      allow create, update, delete: if
        isContentCollection(collection) && isAdmin();
    }
  }
}

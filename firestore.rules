rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "ayrwmWLYxxPa7BReRFZYA3lKHQY2";
    }

    function isContentCollection(collectionName) {
      return collectionName in [
        "regions",
        "places",
        "regionOverrides",
        "placeOverrides",
        "packages",
        "packageOverrides",
        "hotels",
        "hotelOverrides",
        "carRentals",
        "carRentalOverrides",
        "blog"
      ];
    }

    match /{collectionName}/{document=**} {
      // Public: published documents only.
      // Admin: all documents in the allowed collections.
      allow read: if isContentCollection(collectionName)
        && (
          isAdmin()
          || (
            'published' in resource.data
            && resource.data.published == true
          )
        );

      // Only the authenticated admin can modify content.
      allow create, update, delete: if
        isContentCollection(collectionName)
        && isAdmin();
    }
  }
}